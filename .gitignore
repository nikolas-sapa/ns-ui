node_modules/
.next/
public/r/
next-env.d.ts
*.tsbuildinfo
.DS_Store
.vercel

# Secrets — .env.example is the committed template, real values never are.
.env
.env.local
.env*.local

# Generated from meta.json sidecars by `npm run registry:build`.
# Not committed: two branches adding components would otherwise conflict in files
# nobody hand-wrote. Regenerated automatically before dev/typecheck/verify/build,
# and by Vercel on deploy.
registry.json
registry/index.tsx
lib/autoplay.generated.json
lib/card-frame.generated.json
public/llms.txt
public/llms-full.txt

# MCP server's offline snapshot of the registry — same story: regenerated
# by `npm run registry:build` (build-mcp-snapshot.ts) and by mcp/'s own
# `prepack` before every publish. See mcp/README.md.
mcp/data/
# mcp/'s compiled output — Node refuses type stripping under node_modules,
# so unlike the rest of this repo the published package ships build output.
# `npm run build` (mcp/) or `prepack` regenerates it.
mcp/dist/

# debug scratch from agent sessions — never commit
.scratch-dbg/
recordings/

# Local-only working material: research inventories, session notes, ad-hoc
# debug scripts, agent prompts. Kept on disk, deliberately out of the repo.
/.internal/
/noreg.mjs
/sss.mjs
/PARALLEL-SESSION-PROMPT.md
/RESUME.md
/tickets.md
/workflows/
/wiki/.wiki/
/.worktrees/
.scratch-audit/
.scratch-21st/
*.tmp.mjs
__audit_tmp*
*_tmp.mjs

# generated by scripts/build-posters.ts from the committed screenshots
/public/posters/
