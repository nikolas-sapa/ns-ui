node_modules/
.next/
public/r/
next-env.d.ts
*.tsbuildinfo
.DS_Store
.vercel

# Secrets — .env.example is the committed template, real values never are.
.env
.env.local
.env*.local

# Generated from meta.json sidecars by `npm run registry:build`.
# Not committed: two branches adding components would otherwise conflict in files
# nobody hand-wrote. Regenerated automatically before dev/typecheck/verify/build,
# and by Vercel on deploy.
# Exception: registry.json IS committed (see below) — automated directory
# discovery (ethan-krich/ui-registries) scans public repos for that filename.
# The generator is deterministic (sorted meta.json sidecar scan, no
# timestamps), so regenerating it produces no diff.
registry/index.tsx
lib/autoplay.generated.json
lib/card-frame.generated.json
lib/contributors.generated.json
lib/status.generated.json
public/llms.txt
public/llms-full.txt

# MCP server's offline snapshot of the registry — same story: regenerated
# by `npm run registry:build` (build-mcp-snapshot.ts) and by mcp/'s own
# `prepack` before every publish. See mcp/README.md.
mcp/data/
cli/data/
# mcp/'s compiled output — Node refuses type stripping under node_modules,
# so unlike the rest of this repo the published package ships build output.
# `npm run build` (mcp/) or `prepack` regenerates it.
mcp/dist/

# debug scratch from agent sessions — never commit
.scratch-dbg/
recordings/

# Local-only working material: research inventories, session notes, ad-hoc
# debug scripts, agent prompts. Kept on disk, deliberately out of the repo.
/.internal/
/noreg.mjs
/sss.mjs
/PARALLEL-SESSION-PROMPT.md
/RESUME.md
/tickets.md
/workflows/
/wiki/.wiki/
/.worktrees/
.scratch-audit/
.scratch-21st/
*.tmp.mjs
__audit_tmp*
*_tmp.mjs

# generated by scripts/build-posters.ts from the committed screenshots
/public/posters/

# Screenshot states beyond `<theme>-default.png`.
#
# `scripts/verify.ts` writes every state and reads it back WITHIN the same run
# to diff hover/focus/press against default — they are never cross-run
# baselines, so tracking them buys nothing. The only screenshots the BUILD
# consumes are `<theme>-default.png`: `scripts/build-posters.ts` reads them for
# `public/posters/`, and `app/components/[name]/opengraph-image.tsx` serves
# them as the OG card. Those two stay committed, per component.
#
# The rest were 8 of every 10 tracked PNGs and were rewritten byte-for-byte on
# every gate run — ~1,700 files of pure churn per run. That is what grew the
# pack to 462 MiB and made pushes time out on a slow link.
registry/*/*/screenshots/*-hover.png
registry/*/*/screenshots/*-focus.png
registry/*/*/screenshots/*-press.png
registry/*/*/screenshots/*-unfocused.png
registry/*/*/screenshots/*-open.png
registry/*/*/screenshots/*-scroll.png
