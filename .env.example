# Public origin the registry, llms.txt and install commands resolve against.
# Only needed to override the design.helpmarq.com default — see lib/registry-origin.ts.
NEXT_PUBLIC_REGISTRY_ORIGIN=

# EmailOctopus — powers the email capture form (lib/actions/subscribe.ts).
# Generate a key at https://emailoctopus.com/account/api-keys, list id is in
# the list's settings URL. Both are read server-side only; the form degrades
# to a plain error state if either is unset.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Comma-separated, normalized email addresses allowed to claim protected owner
# names (for example, nikolas-sapa variants). Leave empty to fail closed.
OWNER_EMAILS=

# /submit's incremental GitHub OAuth handshake (docs/community-spec.md §2
# Phase C) — app/api/submit/github/{authorize,callback}/route.ts run in this
# Next app, not on the Convex deployment, so they need their own copy of the
# SAME GitHub OAuth App credentials `npx convex env set` puts on the Convex
# deployment for sign-in (convex/auth.ts). Same client id/secret, two places
# it must be set — a missing one here breaks only the submission portal, not
# sign-in, since Convex Auth reads its own copy independently.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Upstream repo the submission portal forks and opens pull requests against.
# Defaults to this repo's own package.json "repository" (nikolas-sapa/ns-ui,
# branch main) — only needed to override for a fork/staging deployment.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_DEFAULT_BRANCH=

# Security-review finding #1: keys the HMAC that binds `ns_ui_submit_gh_token`
# (above) to the Convex identity that obtained it, so the token can't be used
# by a DIFFERENT user who signs in on the same browser after the first user
# signs out (lib/submit-oauth-cookies.ts has the full mechanism). Required —
# `/api/submit/github/callback` and `/api/submit` both fail closed
# (`github_not_configured`, 500) with this unset, rather than minting or
# trusting an unbound token. Any random value; set once per deployment and
# never change it without expecting every currently-connected GitHub token
# to stop validating.
SUBMIT_TOKEN_BINDING_SECRET=
