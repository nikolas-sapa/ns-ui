# Public origin the registry, llms.txt and install commands resolve against.
# Only needed to override the design.helpmarq.com default — see lib/registry-origin.ts.
NEXT_PUBLIC_REGISTRY_ORIGIN=

# EmailOctopus — powers the email capture form (lib/actions/subscribe.ts).
# Generate a key at https://emailoctopus.com/account/api-keys, list id is in
# the list's settings URL. Both are read server-side only; the form degrades
# to a plain error state if either is unset.
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Comma-separated, normalized email addresses allowed to claim protected owner
# names (for example, nikolas-sapa variants). Leave empty to fail closed.
OWNER_EMAILS=
