{
  "name": "ns-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn-compatible registry of React components, each built around one interaction and gated by a Playwright screenshot suite. See README.md for the current count.",
  "keywords": [
    "shadcn",
    "registry",
    "react",
    "tailwind",
    "component-library",
    "motion"
  ],
  "homepage": "https://design.helpmarq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikolas-sapa/ns-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nikolas-sapa/ns-ui/issues"
  },
  "author": "Nikolas Sapalidis",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "next start",
    "registry:build": "node scripts/build-index.ts && node scripts/build-registry.ts && node scripts/build-llms.ts && node scripts/build-autoplay.ts && node scripts/build-contributors.ts && node scripts/build-posters.ts && node scripts/build-mcp-snapshot.ts && node scripts/build-mcp-conventions.ts && node scripts/build-readme.ts && node scripts/build-status.ts && node cli/scripts/build-cli-snapshot.mjs",
    "autoplay:build": "node scripts/build-autoplay.ts",
    "contributors:build": "node scripts/build-contributors.ts",
    "llms:build": "node scripts/build-llms.ts",
    "readme:build": "node scripts/build-readme.ts",
    "typecheck": "tsc --noEmit",
    "test:name-policy": "node scripts/test-name-policy.ts",
    "test:category-coverage": "node scripts/test-category-coverage.ts",
    "test:status-checks": "node scripts/test-status-checks.ts",
    "test:source-invariants": "node scripts/test-source-invariants.ts",
    "test:perf-budget": "node scripts/test-perf-budget.ts",
    "test:agent-readiness": "node scripts/test-agent-readiness.ts",
    "test:convex-deployed": "node scripts/test-convex-deployed.ts",
    "verify": "node scripts/verify.ts",
    "index:build": "node scripts/build-index.ts",
    "pretypecheck": "npm run registry:build",
    "predev": "npm run registry:build",
    "preverify": "npm run registry:build",
    "order:build": "node scripts/build-order.ts",
    "record": "node scripts/record.ts",
    "previews:build": "node scripts/build-previews.ts"
  },
  "dependencies": {
    "@convex-dev/auth": "0.0.94",
    "@react-three/fiber": "9.6.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "convex": "1.42.3",
    "geist": "1.7.2",
    "lenis": "1.3.25",
    "motion": "12.42.2",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "playwright": "1.61.1",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
