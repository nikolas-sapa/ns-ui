{
  "name": "ns-ui",
  "version": "0.1.0",
  "private": true,
  "description": "A shadcn-compatible registry of 206 React components, each built around one interaction and gated by a Playwright screenshot suite.",
  "keywords": [
    "shadcn",
    "registry",
    "react",
    "tailwind",
    "component-library",
    "motion"
  ],
  "homepage": "https://design.helpmarq.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nikolas-sapa/ns-ui.git"
  },
  "bugs": {
    "url": "https://github.com/nikolas-sapa/ns-ui/issues"
  },
  "author": "Nikolas Sapalidis",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run registry:build && next build",
    "start": "next start",
    "registry:build": "node scripts/build-index.ts && node scripts/build-registry.ts && node scripts/build-llms.ts && node scripts/build-autoplay.ts",
    "autoplay:build": "node scripts/build-autoplay.ts",
    "llms:build": "node scripts/build-llms.ts",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.ts",
    "index:build": "node scripts/build-index.ts",
    "pretypecheck": "npm run registry:build",
    "predev": "npm run registry:build",
    "preverify": "npm run registry:build",
    "order:build": "tsx scripts/build-order.ts",
    "record": "node scripts/record.ts"
  },
  "dependencies": {
    "@react-three/fiber": "9.6.1",
    "geist": "1.7.2",
    "motion": "12.42.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "playwright": "1.61.1",
    "shadcn": "4.13.0",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
